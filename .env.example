# Environment Configuration for OpenMusic AI Studio

# Application Settings
DEBUG=false
DEVICE=auto

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Model Settings
MUSICGEN_MODEL=facebook/musicgen-small
BARK_MODEL=suno/bark
LLM_MODEL=gpt2

# Audio Settings
SAMPLE_RATE=32000
AUDIO_FORMAT=wav
MAX_DURATION=120

# Security
CORS_ORIGINS=*

# Optional: Database URL
# DATABASE_URL=sqlite:///./openmusic.db

# Optional: Ollama Settings
# OLLAMA_BASE_URL=http://localhost:11434